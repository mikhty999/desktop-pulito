<Project Sdk="Microsoft.NET.Sdk">
  <!-- Adattatori concreti delle porte: Windows (desktop, sfondo, transizioni), servizi online gratuiti, salvataggio. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DesktopPulito.Infrastructure</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DesktopPulito.Application\DesktopPulito.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>
</Project>
