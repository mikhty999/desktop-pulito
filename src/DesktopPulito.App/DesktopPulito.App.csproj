<Project Sdk="Microsoft.NET.Sdk">
  <!-- Presentazione (interfaccia in vetro, icona nell'area di notifica) e composizione delle dipendenze. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DesktopPulito.App</RootNamespace>
    <AssemblyName>DesktopPulito</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- avvio rapido: codice precompilato -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- le stringhe in italiano nei commenti/codice sono intenzionali -->
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DesktopPulito.Infrastructure\DesktopPulito.Infrastructure.csproj" />
  </ItemGroup>
</Project>
